    },
    {
      "id": "gzDkgyGHDb9yTp8DGa7uM",
      "type": "text",
      "x": 661.23828125,
      "y": 2286.59375,
      "width": 341.2840881347656,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8Z",
      "roundness": null,
      "seed": 1577050864,
      "version": 942,
      "versionNonce": 800010992,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777823067541,
      "link": null,
      "locked": false,
      "text": "Order Service is a stateless \nservice. Receives the request,\nhashes the user id, to route the request\nto a specific node\nwithin our sharded Redis cluster.\nIt executes an atomic Lua script, that\nchecks the inventory.\nIf stock available, decrement it and place \na 5 minute hold on \nthe item.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order Service is a stateless \nservice. Receives the request,\nhashes the user id, to route the request to a specific node\nwithin our sharded Redis cluster.\nIt executes an atomic Lua script, that checks the inventory.\nIf stock available, decrement it and place \na 5 minute hold on \nthe item.",
      "autoResize": false,
      "lineHeight": 1.25
    },
