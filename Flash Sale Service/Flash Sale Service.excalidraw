    {
      "id": "SVK7M6V22-bzjiEwpCDvy",
      "type": "text",
      "x": 295.05859375,
      "y": 388.00390625,
      "width": 399.3759460449219,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b85",
      "roundness": null,
      "seed": 1996714036,
      "version": 302,
      "versionNonce": 992830900,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777760357022,
      "link": null,
      "locked": false,
      "text": "1. View a product\n2. Purchasing a product\n3. Order status\n4. Timeouts : Imagine a payment is initiated, but\nthe payment is never completed, it should time out,\nand returned to the product pool to be able to be\npurchased by someone else.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. View a product\n2. Purchasing a product\n3. Order status\n4. Timeouts : Imagine a payment is initiated, but\nthe payment is never completed, it should time out,\nand returned to the product pool to be able to be\npurchased by someone else.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0wzhZpBTYOKZvNAvqhHd3",
      "type": "text",
      "x": 883,
      "y": 393.234375,
      "width": 426.239990234375,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b86",
      "roundness": null,
      "seed": 16879884,
      "version": 575,
      "versionNonce": 1795481012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777760607742,
      "link": null,
      "locked": false,
      "text": "1. Extreme Scalability : Our system should be able \nto handle the load of a massive flow of users\n2. Strict Consistency : Our system should sell the \nexact number of products in the inventory,\nnot a single one more\n3. High Availability : \n99.99% time for the edge infrastructure and queueing\nlayers. Graceful degradation is preferred over hard \ncrashing.\n4. Low Latency : Less than 100ms response time to \nacknowledge a user's purchase attempt and place them\nin the fulfilment queue.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Extreme Scalability : Our system should be able \nto handle the load of a massive flow of users\n2. Strict Consistency : Our system should sell the \nexact number of products in the inventory,\nnot a single one more\n3. High Availability : \n99.99% time for the edge infrastructure and queueing\nlayers. Graceful degradation is preferred over hard \ncrashing.\n4. Low Latency : Less than 100ms response time to \nacknowledge a user's purchase attempt and place them\nin the fulfilment queue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
