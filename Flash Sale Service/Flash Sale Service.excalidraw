    },
    {
      "id": "L-ma-0RbvZu3T9c_SgE3m",
      "type": "text",
      "x": 250.66666666666697,
      "y": 5408.62109375,
      "width": 220.3199920654297,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
