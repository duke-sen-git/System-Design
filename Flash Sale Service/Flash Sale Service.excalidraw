      "isDeleted": false,
      "boundElements": null,
      "updated": 1777823213793,
      "link": null,
      "locked": false,
      "text": "Apache Kafka",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apache Kafka",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X3mUSfS_ICSx2lbkLhRt2",
      "type": "text",
      "x": 1090.91796875,
      "y": 2272.6015625,
      "width": 252.1280059814453,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8n",
      "roundness": null,
      "seed": 2085068016,
      "version": 218,
      "versionNonce": 1193893104,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777823327349,
      "link": null,
      "locked": false,
      "text": "The Order service\nputs a check out event in \nApache Kafka queue as soon as \nthe Redis reservation succeeds.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Order service\nputs a check out event in \nApache Kafka queue as soon as \nthe Redis reservation succeeds.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "55de6Jrb8--Vo35e9eUjb",
      "type": "text",
      "x": 600.46875,
      "y": 2115.671875,
      "width": 295.1679992675781,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8o",
      "roundness": null,
      "seed": 766353936,
      "version": 376,
      "versionNonce": 1353906704,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777823638540,
      "link": null,
      "locked": false,
      "text": "Order service then returns a 202 \naccepted to our client and a queue\nticket id. UI can then start showing\na loading anim and begin short polling\na read optimised Redis cache via the\norder service to wait for our payment\nlink",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order service then returns a 202 \naccepted to our client and a queue\nticket id. UI can then start showing\na loading anim and begin short polling\na read optimised Redis cache via the\norder service to wait for our payment\nlink",
      "autoResize": true,
      "lineHeight": 1.25
    },
