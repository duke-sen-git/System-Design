    {
      "id": "nKYILzpmz9ol39_gVyv2E",
      "type": "text",
      "x": 106.3184135422423,
      "y": 4768.40625,
      "width": 445.0879821777344,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9h",
      "roundness": null,
      "seed": 300777712,
      "version": 701,
      "versionNonce": 1419670032,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778167980118,
      "link": null,
      "locked": false,
      "text": "Clients get their data from the CDN. The\nCDN will absorb 99.9% of our pre sale read \ntraffic as millions of users start visiting the site.\nIt will serve the HTML, CSS, Javascript which \nsyncs with the server time via a highly cached \nendpoint which runs the countdown locally.\nEnsures if our sale has a countdown, all the users\nsee the countdown. Because it is synced with the server\ntime, they all see the same time, regardless of where\nthey are",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Clients get their data from the CDN. The\nCDN will absorb 99.9% of our pre sale read \ntraffic as millions of users start visiting the site.\nIt will serve the HTML, CSS, Javascript which \nsyncs with the server time via a highly cached \nendpoint which runs the countdown locally.\nEnsures if our sale has a countdown, all the users\nsee the countdown. Because it is synced with the server\ntime, they all see the same time, regardless of where\nthey are",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h29PXOnm9DkvHswy7FvUG",
      "type": "text",
      "x": 341.2111328110411,
      "y": 5520.90234375,
      "width": 267.5840148925781,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9i",
      "roundness": null,
      "seed": 745530096,
      "version": 281,
      "versionNonce": 1416142864,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778167985120,
      "link": null,
      "locked": false,
      "text": "- Handle massive bursts of POST\nrequests\n- Filter out bad actors\n- Rate limit\n- Validate session tokens\nPasses on the clean traffic to BE\nservices",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Handle massive bursts of POST\nrequests\n- Filter out bad actors\n- Rate limit\n- Validate session tokens\nPasses on the clean traffic to BE\nservices",
      "autoResize": true,
      "lineHeight": 1.25
    },
