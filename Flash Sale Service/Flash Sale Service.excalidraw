    {
      "id": "t_ZemI_M0y6BRCtRP0B67",
      "type": "text",
      "x": 2056.7152889237123,
      "y": 5066.267578125,
      "width": 445.10394287109375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAJ",
      "roundness": null,
      "seed": 1288981744,
      "version": 629,
      "versionNonce": 806704144,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778167999413,
      "link": null,
      "locked": false,
      "text": "Expiration workers for clean up purposes.\nClient successfully redirects to payment page\nbut abandons / fails payment, and 5 mins pass,\nthe workers detects this expired hold. It will\ncancel the Postgres order and increment the inventory\n                                    back up on the exact\n                                    same Redis shard that \n                                    the user came from, bcoz\n                                    we wamt to make it\n                                    available again for purchase",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Expiration workers for clean up purposes.\nClient successfully redirects to payment page\nbut abandons / fails payment, and 5 mins pass,\nthe workers detects this expired hold. It will\ncancel the Postgres order and increment the inventory\n                                    back up on the exact\n                                    same Redis shard that \n                                    the user came from, bcoz\n                                    we wamt to make it\n                                    available again for purchase",
      "autoResize": true,
      "lineHeight": 1.25
    },
