    {
      "id": "E_gCKnGlCvtcgbVmicKJL",
      "type": "text",
      "x": 393.66666666666697,
      "y": 3302.9999999999995,
      "width": 6.400000095367432,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
