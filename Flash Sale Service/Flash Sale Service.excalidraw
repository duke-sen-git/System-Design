      "text": "Order\nProcessors",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order\nProcessors",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HQPqVxz9VIB78Pns5-KJp",
      "type": "text",
      "x": 1728.1564483642578,
      "y": 1936.41015625,
      "width": 324.33944702148426,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8w",
      "roundness": null,
      "seed": 52465168,
      "version": 800,
      "versionNonce": 548915728,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777824807861,
      "link": null,
      "locked": false,
      "text": "Order processor consume events from\nKafka at a steady rate. For each event,\nthey request a secure checkout url, from\nthe Payment gateway and then write the\npending payment order into Postgres and\npush the checkout url upto the read\noptimised Redis cache that the user is\npolling.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order processor consume events from Kafka at a steady rate. For each event, they request a secure checkout url, from the Payment gateway and then write the pending payment order into Postgres and push the checkout url upto the read optimised Redis cache that the user is polling.",
      "autoResize": false,
      "lineHeight": 1.25
    },
