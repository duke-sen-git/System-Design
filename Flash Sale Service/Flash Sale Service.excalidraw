    },
    {
      "id": "d9ssSDqtuK_tB3cJfF24f",
      "type": "text",
      "x": 415.66666666666697,
      "y": 4291.1171875,
      "width": 1026.1920166015625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9W",
      "roundness": null,
      "seed": 1167778032,
      "version": 503,
      "versionNonce": 1517419024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778166983066,
      "link": null,
      "locked": false,
      "text": "Web sockets actually provide true real time bi-directional communication -- client to server and server to client. However\nholding open a million persistent TCP connections for a flash sale requires massive server fleet, aggressive load balance tuning and \ncomplex connection state management.\nA user might be waiting in the queue for 5 - 30 sec, this operational overhead is an extreme anti pattern.\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Web sockets actually provide true real time bi-directional communication -- client to server and server to client. However\nholding open a million persistent TCP connections for a flash sale requires massive server fleet, aggressive load balance tuning and \ncomplex connection state management.\nA user might be waiting in the queue for 5 - 30 sec, this operational overhead is an extreme anti pattern.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sCFPS2FBZ-dkLBzkAzC3c",
      "type": "text",
      "x": 413.66666666666697,
      "y": 4411.5,
