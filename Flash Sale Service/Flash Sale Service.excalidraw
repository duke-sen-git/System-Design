      "boundElements": null,
      "updated": 1778170409405,
      "link": null,
      "locked": false,
      "text": "Push a copy of the Payment url\nto our read optimised Redid replica.\nThis read optimised Redis cache then\nsuccessfully answers the Short polling\nrequest by replying with the newly \ngenerated payment url, prompting\nthe browser to redirect to the\nStripe or the Paypal page.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Push a copy of the Payment url\nto our read optimised Redid replica.\nThis read optimised Redis cache then\nsuccessfully answers the Short polling\nrequest by replying with the newly \ngenerated payment url, prompting\nthe browser to redirect to the\nStripe or the Paypal page.",
      "autoResize": true,
      "lineHeight": 1.25
    },
