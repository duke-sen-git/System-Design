      "isDeleted": false,
      "boundElements": [],
      "updated": 1778167977113,
      "link": null,
      "locked": false,
      "text": "Apache Kafka",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apache Kafka",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U2uiyUU1noLgIeFt-dEcG",
      "type": "text",
      "x": 1057.8205078110411,
      "y": 5287.0546875,
      "width": 252.1280059814453,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9w",
      "roundness": null,
      "seed": 758316784,
      "version": 283,
      "versionNonce": 105548528,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778167996322,
      "link": null,
      "locked": false,
      "text": "The Order service\nputs a check out event in \nApache Kafka queue as soon as \nthe Redis reservation succeeds.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Order service\nputs a check out event in \nApache Kafka queue as soon as \nthe Redis reservation succeeds.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-7oSuazl9nqA_YqSeSTqD",
      "type": "text",
      "x": 567.3712890610411,
      "y": 5130.427734375,
      "width": 295.1679992675781,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9x",
      "roundness": null,
      "seed": 2119540976,
      "version": 442,
      "versionNonce": 1466231824,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778167981536,
      "link": null,
      "locked": false,
      "text": "Order service then returns a 202 \naccepted to our client and a queue\nticket id. UI can then start showing\na loading anim and begin short polling\na read optimised Redis cache via the\norder service to wait for our payment\nlink",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order service then returns a 202 \naccepted to our client and a queue\nticket id. UI can then start showing\na loading anim and begin short polling\na read optimised Redis cache via the\norder service to wait for our payment\nlink",
      "autoResize": true,
      "lineHeight": 1.25
    },
