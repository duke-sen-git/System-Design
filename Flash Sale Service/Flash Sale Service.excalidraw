      "versionNonce": 1913801232,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1778169501871,
      "link": null,
      "locked": false,
      "text": "Client side JS, once it gets the ticket id, starts a loading spinner and",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client side JS, once it gets the ticket id, starts a loading spinner and",
      "autoResize": true,
      "lineHeight": 1.25
    },
