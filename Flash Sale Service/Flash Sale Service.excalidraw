    {
      "id": "wFpBH1k2NW05hdh9qWo5l",
      "type": "text",
      "x": 308,
      "y": 1075.5,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
