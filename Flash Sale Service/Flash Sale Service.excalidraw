    {
      "id": "8yHjMmnLnsEL4ERWIO62K",
      "type": "text",
      "x": 303,
      "y": 1068.734375,
      "width": 915.919921875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8I",
      "roundness": null,
      "seed": 1739160304,
      "version": 610,
      "versionNonce": 1022802672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777762933175,
      "link": null,
      "locked": false,
      "text": "APIs should be light weight, aggressively cached where possible, and of course kind of strict \nidempotency keys to handle panicked user retries etc.\n\nGet Sale Details : \nGET :  /v1/sales/{saleId}\nAggressively cached at the CDN edge\n\nCheckout / Reserve : \nPOST : /v1/sales/{saleId}/checkout\nRequires user id, product id, idempotency key\nReturns 202 accepted, with a queue_ticket_id if inventory is reserved.\nElse, 409 - Conflict or 410 Gone if sold out",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs should be light weight, aggressively cached where possible, and of course kind of strict \nidempotency keys to handle panicked user retries etc.\n\nGet Sale Details : \nGET :  /v1/sales/{saleId}\nAggressively cached at the CDN edge\n\nCheckout / Reserve : \nPOST : /v1/sales/{saleId}/checkout\nRequires user id, product id, idempotency key\nReturns 202 accepted, with a queue_ticket_id if inventory is reserved.\nElse, 409 - Conflict or 410 Gone if sold out",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xwd3Qha9k3WasqeppQS0R",
      "type": "text",
      "x": 306,
      "y": 1392.6171875,
      "width": 522.3399658203125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
