      "isDeleted": false,
      "boundElements": null,
      "updated": 1778169536163,
      "link": null,
      "locked": false,
      "text": "Executes a targeted Lua\nscript on the targeted shard\nand decrement inventory.\nIf stock is available, returns a\nsuccess flag and puts a 5 min TTL\nhold on that key.\nOrder service on successful Redis\ndecrements, publish a checkout\nevent to our message broker, Kafka",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Executes a targeted Lua\nscript on the targeted shard\nand decrement inventory.\nIf stock is available, returns a\nsuccess flag and puts a 5 min TTL\nhold on that key.\nOrder service on successful Redis\ndecrements, publish a checkout\nevent to our message broker, Kafka",
      "autoResize": true,
      "lineHeight": 1.25
    },
