    {
      "id": "uRAwui5Z7vlHd2RprNqmO",
      "type": "text",
      "x": 418.66666666666697,
      "y": 4287,
      "width": 6.400000095367432,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9V",
      "roundness": null,
      "seed": 848214256,
      "version": 6,
      "versionNonce": 1233044496,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1778166061178,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
