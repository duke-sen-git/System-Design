      "text": "Massive\namount of\nusers hit\nour post\ncheckout\nendpoint.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Massive\namount of\nusers hit\nour post\ncheckout\nendpoint.",
      "autoResize": true,
