    {
      "id": "-egqq2GslKO6oDVDxSAB5",
      "type": "text",
      "x": 299.07421875,
      "y": 756.76171875,
      "width": 768.0399169921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8E",
      "roundness": null,
      "seed": 876950256,
      "version": 259,
      "versionNonce": 713581584,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777761755299,
      "link": null,
      "locked": false,
      "text": "In memory store (Redis Cluster)\n- Used for high speed, atomic inventory management\n- Redis handles the immediate transactional state (item_id -> available_stock)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In memory store (Redis Cluster)\n- Used for high speed, atomic inventory management\n- Redis handles the immediate transactional state (item_id -> available_stock)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rAJ2yxwk0hGhObpUjAxQp",
      "type": "text",
      "x": 304,
      "y": 863.37890625,
      "width": 930.8199462890625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8F",
      "roundness": null,
      "seed": 164590320,
      "version": 303,
      "versionNonce": 1015727632,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777761936179,
      "link": null,
      "locked": false,
      "text": "Relational Database (PostgreSQL)\n- Serves as the system's source of truth for completed orders, user data and financial records\n- It is shielded from the traffic bursts by the message queue and relies heavily on ACID\nproperties to finalise state\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relational Database (PostgreSQL)\n- Serves as the system's source of truth for completed orders, user data and financial records\n- It is shielded from the traffic bursts by the message queue and relies heavily on ACID\nproperties to finalise state\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
