    {
      "id": "XfRXnbggaSb6G2kQ0xDWT",
      "type": "text",
      "x": -107.73958333333303,
      "y": 5040.06640625,
      "width": 348.8639831542969,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAO",
      "roundness": null,
      "seed": 1720515824,
      "version": 373,
      "versionNonce": 596643056,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778168212907,
      "link": null,
      "locked": false,
      "text": "CDN absorbs 99.9% of all the pre sale read\ntraffic, in the hours leading up to the event,\nserving our cached product details and the\nproduct timer payload to the millions of \nwaiting users.\nThe client side JS in the client handles \nthe countdown and visually represents \nthe buy button.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CDN absorbs 99.9% of all the pre sale read\ntraffic, in the hours leading up to the event,\nserving our cached product details and the\nproduct timer payload to the millions of \nwaiting users.\nThe client side JS in the client handles \nthe countdown and visually represents \nthe buy button.",
      "autoResize": true,
      "lineHeight": 1.25
    },
