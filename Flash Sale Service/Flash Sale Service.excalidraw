    {
      "id": "gT3VuhjbRibqyn5B4oXek",
      "type": "text",
      "x": 407.66666666666697,
      "y": 4173.11328125,
      "width": 1007.2162475585938,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9T",
      "roundness": null,
      "seed": 1946431728,
      "version": 280,
      "versionNonce": 2038553328,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778165805577,
      "link": null,
      "locked": false,
      "text": "When a users successfully reserves an item, they instantly receive a 202 accepted and a queue ticket id.\nThe client must somehow learn when the background worker has finished creating the database record and generating the Stripe\ncheckout url.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When a users successfully reserves an item, they instantly receive a 202 accepted and a queue ticket id.\nThe client must somehow learn when the background worker has finished creating the database record and generating the Stripe\ncheckout url.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1K26ZLDczYWOVPIB5tZU_",
