      "isDeleted": false,
      "boundElements": null,
      "updated": 1778169713497,
      "link": null,
      "locked": false,
      "text": "We can have Order Processors, our worker nodes, \nsafely drain the message broker, by consuming \nevents at a steady pace and inserting the initial\n PENDING_PAYMENT orders to our Postgres DB. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can have Order Processors, our worker nodes, \nsafely drain the message broker, by consuming \nevents at a steady pace and inserting the initial\n PENDING_PAYMENT orders to our Postgres DB. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
