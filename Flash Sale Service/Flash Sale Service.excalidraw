      "seed": 1469850640,
      "version": 119,
      "versionNonce": 1359271952,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777763049786,
      "link": null,
      "locked": false,
      "text": "Poll Status : \nGET : /v1/orders/status/{queue_ticket_id}\nReturns PENDING, AWAITING_PAYMENT or FAILED",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Poll Status : \nGET : /v1/orders/status/{queue_ticket_id}\nReturns PENDING, AWAITING_PAYMENT or FAILED",
      "autoResize": true,
      "lineHeight": 1.25
    },
