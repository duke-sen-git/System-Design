      "link": null,
      "locked": false,
      "text": "Short Polling",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Short Polling",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hKGU2ZbZVbMC89KKkNSAt",
      "type": "text",
      "x": 420.66666666666697,
      "y": 4447.109375,
      "width": 1067.376220703125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9Y",
      "roundness": null,
      "seed": 2116618256,
      "version": 660,
      "versionNonce": 1027354352,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1778167322525,
      "link": null,
      "locked": false,
      "text": "The client side JS implements a short polling mechanism. Every 2 secs, the browser fires a light weight GET v1 order status, queue\nticket id request.\nIf 10,000 requests are polling every 2 seconds, it is 5,000 reqs / sec.\nTo prevent this polling from hammering the DB, the worker nodes are writing our Stripe url to that separate read optimised Redis \ncache. The polling then performs a O(1) fetch against this cache and once the url appears, the client can instantly redirect the user to \nthat payment page.\nGo for polling, not web sockets.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The client side JS implements a short polling mechanism. Every 2 secs, the browser fires a light weight GET v1 order status, queue\nticket id request.\nIf 10,000 requests are polling every 2 seconds, it is 5,000 reqs / sec.\nTo prevent this polling from hammering the DB, the worker nodes are writing our Stripe url to that separate read optimised Redis \ncache. The polling then performs a O(1) fetch against this cache and once the url appears, the client can instantly redirect the user to \nthat payment page.\nGo for polling, not web sockets.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
