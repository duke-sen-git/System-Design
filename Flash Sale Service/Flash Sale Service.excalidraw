    {
      "id": "RqnsRKbFTB9GomvSzmvAB",
      "type": "text",
      "x": 1276.3439453110411,
      "y": 5258.12890625,
      "width": 130.8400115966797,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
