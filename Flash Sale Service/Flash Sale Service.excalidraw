    {
      "id": "HgCTb5Gk7ntpuWX67tKkq",
      "type": "text",
      "x": 1309.44140625,
      "y": 2243.67578125,
      "width": 130.8400115966797,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
