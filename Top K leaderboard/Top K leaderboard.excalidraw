    },
    {
      "id": "tnhJhM6P_HFb9nH9PuQye",
      "type": "text",
      "x": 1202.9285705815087,
      "y": 3154.0729004520467,
      "width": 358.3839416503906,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3n",
      "roundness": null,
      "seed": 241350003,
      "version": 615,
      "versionNonce": 1471569139,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Workflow orchestrator would be implemented\nby Temporal.\nThis will be the state machine manager that\nmanages the complex DAG, so direct acyclical \ngraph of video processing tasks, retries and\nparallel routing",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workflow orchestrator would be implemented\nby Temporal.\nThis will be the state machine manager that\nmanages the complex DAG, so direct acyclical \ngraph of video processing tasks, retries and\nparallel routing",
      "autoResize": true,
      "lineHeight": 1.25
    },
