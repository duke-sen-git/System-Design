    {
      "id": "hTsvIvcGNruMZ5v4EytXo",
      "type": "text",
      "x": 113.87890625,
      "y": 621.2421875,
      "width": 513.4559936523438,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5o",
      "roundness": null,
      "seed": 112705917,
      "version": 436,
      "versionNonce": 1875562771,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777238102221,
      "link": null,
      "locked": false,
      "text": "1. Update Score : \nPOST /v1/scores : \nBody : {\"uId\" : 12345, score : \"12...456\"}\n\n2. Get Global Leaderboard \nGET : /v1/leaderboards/{lb_id}/top?k=10\nResponse : [{\"uId\" : 12345, \"score\" : \"12...456\", \"rank\" : 1}, ....]\n\n3. Get Rankings and neighbours : \nGET : /v1/leaderboards/{lb_id}/users/{userId}/context?range=5\nResponse : Returns the user's rank plus 5 users above and below",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Update Score : \nPOST /v1/scores : \nBody : {\"uId\" : 12345, score : \"12...456\"}\n\n2. Get Global Leaderboard \nGET : /v1/leaderboards/{lb_id}/top?k=10\nResponse : [{\"uId\" : 12345, \"score\" : \"12...456\", \"rank\" : 1}, ....]\n\n3. Get Rankings and neighbours : \nGET : /v1/leaderboards/{lb_id}/users/{userId}/context?range=5\nResponse : Returns the user's rank plus 5 users above and below",
      "autoResize": true,
      "lineHeight": 1.25
    },
