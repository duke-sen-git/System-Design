      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Finally the client from the video\nmetadata which contains CDN\nurls, will talk to the CDN to get\nthe video chunks and starts \nplaying.",
      "autoResize": true,
      "lineHeight": 1.25
    },
