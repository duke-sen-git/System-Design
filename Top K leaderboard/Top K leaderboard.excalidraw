    {
      "id": "AgIB019XcX9v3aObQkqEa",
      "type": "text",
      "x": 489.928193636566,
      "y": 2534.674670822984,
      "width": 191.0240478515625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3b",
      "roundness": null,
      "seed": 1614881907,
      "version": 204,
      "versionNonce": 1845963229,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Client interacts with our\nsystem by the load \nbalancer",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client interacts with our\nsystem by the load \nbalancer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x5YjDu8sdU_WcyJkc2O1t",
      "type": "text",
      "x": 477.554954194242,
      "y": 2342.7580091537466,
      "width": 233.88804006576535,
      "height": 94.9375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3c",
      "roundness": null,
      "seed": 292741501,
      "version": 412,
      "versionNonce": 952020595,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "The load balancer is responsible for : \n-- SSL termination\n-- Rate Limitation\n-- Load Balancing\n-- Prevention of DDos attacks\n-- Authentication",
      "fontSize": 12.65833333333333,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The load balancer is responsible for : \n-- SSL termination\n-- Rate Limitation\n-- Load Balancing\n-- Prevention of DDos attacks\n-- Authentication",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TbKU10Dx8aPD-JkzgbGjq",
      "type": "text",
      "x": 967.2096802095481,
      "y": 2364.537173241028,
      "width": 360.14398193359375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3d",
      "roundness": null,
      "seed": 92898589,
      "version": 583,
      "versionNonce": 983557693,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "For video upload the client talks to the Video\nUpload Service. This service returns with a \npre-signed S3 url for the client to upload \ntheir video",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For video upload the client talks to the Video\nUpload Service. This service returns with a \npre-signed S3 url for the client to upload \ntheir video",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nJoIPq5oASexydzDmqlU-",
      "type": "text",
      "x": 277.36996830150383,
      "y": 2866.2078567817375,
      "width": 224.70399475097656,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3e",
      "roundness": null,
      "seed": 1380747581,
      "version": 232,
      "versionNonce": 744908819,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Clients upload directly to \nthe S3 backed video storage",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Clients upload directly to \nthe S3 backed video storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
