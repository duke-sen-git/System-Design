      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "0viX46Qv0PDI9ozyeWXGw",
      "type": "text",
      "x": 92,
      "y": -42,
      "width": 391.6480407714844,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5b",
      "roundness": null,
      "seed": 1698280915,
      "version": 281,
      "versionNonce": 1102559667,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777235024988,
      "link": null,
      "locked": false,
      "text": "1. Users should be able to update their score\n2. Users should be able to view their score\n3. We should be able to find the top K players by \na parameter\n4. A user should be able to view their rank",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Users should be able to update their score\n2. Users should be able to view their score\n3. We should be able to find the top K players by \na parameter\n4. A user should be able to view their rank",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RgzYgiqrM7PZMX_nm15ZU",
      "type": "text",
      "x": 650.87890625,
      "y": -49.87890625,
      "width": 483.8240051269531,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5c",
      "roundness": null,
      "seed": 1785000541,
      "version": 520,
      "versionNonce": 755262525,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777235425176,
      "link": null,
      "locked": false,
      "text": "1. 10M DAU, with around roughly 50k updates per second\n2. Read throughput of around 500k requests per second\n3. Latency : < 20 ms at p99 for fetching top K users\nUpdates should be reflected in the system in 1 - 2 sec,\nlike in near real time\n4. High Availability : \n99.9% for the read uptime -- the users must always see some\nscore on the leaderboard, even if it means slightly stale data.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 10M DAU, with around roughly 50k updates per second\n2. Read throughput of around 500k requests per second\n3. Latency : < 20 ms at p99 for fetching top K users\nUpdates should be reflected in the system in 1 - 2 sec,\nlike in near real time\n4. High Availability : \n99.9% for the read uptime -- the users must always see some\nscore on the leaderboard, even if it means slightly stale data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
