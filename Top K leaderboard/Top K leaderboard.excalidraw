      "updated": 1777242589140,
      "link": null,
      "locked": false,
      "text": "",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Km0TTbTlcHVTS2r29EIbO",
      "type": "text",
      "x": 499.5690104166665,
      "y": 1078.276041666667,
      "width": 502.8958740234375,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6S",
      "roundness": null,
      "seed": 488742717,
      "version": 579,
      "versionNonce": 405991741,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777242869590,
      "link": null,
      "locked": false,
      "text": "If we have 10M active users and all of them score \npoints at every second, hitting Redis is inefficient. The solution\nis to use a Write Back cache.\nIn our leaderboard service, it will aggregate score increments \nover a specific user over a short window -- like 5 secs or till\nthe buffer is full. The leaderboard service would send to the \nRedis aggregations, like instead of 5 kills of 10 points each, \nsend 1 update of 50 points for the user.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If we have 10M active users and all of them score \npoints at every second, hitting Redis is inefficient. The solution\nis to use a Write Back cache.\nIn our leaderboard service, it will aggregate score increments \nover a specific user over a short window -- like 5 secs or till\nthe buffer is full. The leaderboard service would send to the \nRedis aggregations, like instead of 5 kills of 10 points each, \nsend 1 update of 50 points for the user.",
      "autoResize": true,
      "lineHeight": 1.25
    },
