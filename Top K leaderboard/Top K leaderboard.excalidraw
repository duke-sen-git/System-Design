    {
      "id": "Coc9d6Ft3kdK68lkKSFWu",
      "type": "text",
      "x": 914.4105773279209,
      "y": 2756.544755840177,
      "width": 447.9999694824219,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
