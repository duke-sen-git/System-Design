    },
    {
      "id": "tpzw6GqWMcsb-VjKdmz-W",
      "type": "arrow",
      "x": 1239.7798819322643,
      "y": 1329.1161458333336,
      "width": 183.93626390106874,
      "height": 0.959374999999909,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6c",
