      "isDeleted": false,
      "boundElements": null,
      "updated": 1777242876290,
      "link": null,
      "locked": false,
      "text": "Stateless BE service that orchestrates\nthe flow of data. Contains business rules\nand also does validation. So when a score\ncomes in, verifies if it is legitimate like \nchecking if a user reached million points in \n5 seconds.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Stateless BE service that orchestrates\nthe flow of data. Contains business rules\nand also does validation. So when a score\ncomes in, verifies if it is legitimate like \nchecking if a user reached million points in \n5 seconds.",
      "autoResize": true,
      "lineHeight": 1.25
    },
