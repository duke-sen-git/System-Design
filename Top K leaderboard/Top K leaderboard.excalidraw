      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Recommendation Service gets the request and makes\na call to the ML cache.\nPost steps 12 + 13, it will have the videos to recommend.\n\nIt can make a request to the CDN, that caches the \ncontent close to the user to guarantee high bandwith\nlow latency streaming.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recommendation Service gets the request and makes\na call to the ML cache.\nPost steps 12 + 13, it will have the videos to recommend.\n\nIt can make a request to the CDN, that caches the \ncontent close to the user to guarantee high bandwith\nlow latency streaming.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
