    {
      "id": "eMi9-TfKI_E9VIB9AiedH",
      "type": "text",
      "x": 983.0924479166665,
      "y": 1366.904947916667,
      "width": 321.3440246582031,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
