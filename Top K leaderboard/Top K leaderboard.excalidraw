    {
      "id": "lvV9u8IfRHPraj1fCOj0k",
      "type": "text",
      "x": 1580.140952045306,
      "y": 3154.573634348599,
      "width": 317.90399169921875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#121212",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3t",
      "roundness": null,
      "seed": 1759215603,
      "version": 615,
      "versionNonce": 948917373,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Within here we can have specific\nCPU or GPU intensive nodes that \nwould listen to specific Temporal \nevents and would be responsible \nfor processing that particular task.\n\nGPU Nodes : AI / ML tasks\nCPU Nodes : Complex FFmpeg Operations\nlike slicing video, converting to diff \nresolutions",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Within here we can have specific\nCPU or GPU intensive nodes that \nwould listen to specific Temporal \nevents and would be responsible \nfor processing that particular task.\n\nGPU Nodes : AI / ML tasks\nCPU Nodes : Complex FFmpeg Operations\nlike slicing video, converting to diff \nresolutions",
      "autoResize": true,
      "lineHeight": 1.25
    },
