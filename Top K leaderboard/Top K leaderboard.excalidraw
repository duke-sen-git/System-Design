    {
      "id": "5JRNFF37hSORGzT7ayNly",
      "type": "text",
      "x": 1798.076301892598,
      "y": 1651.0911458333333,
      "width": 571.3279418945312,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6A",
      "roundness": null,
      "seed": 315722803,
      "version": 607,
      "versionNonce": 1362340595,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777243412438,
      "link": null,
      "locked": false,
      "text": "Traditional databases are too slow for handling updates to millions of \nrows, we will use Redis, specifically with Redis sorted sets. This is high \nspeed temporary index, that maintains the list of user ids and maintains \nscores in pre sorted order. This allows for operations like update score \nand get rank in O(log N) time, thus meaning it remains fast, even as the \nnumber of users grow.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Traditional databases are too slow for handling updates to millions of \nrows, we will use Redis, specifically with Redis sorted sets. This is high \nspeed temporary index, that maintains the list of user ids and maintains \nscores in pre sorted order. This allows for operations like update score \nand get rank in O(log N) time, thus meaning it remains fast, even as the \nnumber of users grow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
