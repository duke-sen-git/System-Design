      "type": "text",
      "x": 603.0418326001305,
      "y": 2935.1673297171815,
      "width": 256.5119934082031,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
