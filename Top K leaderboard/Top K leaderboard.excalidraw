      "link": null,
      "locked": false,
      "text": "For durability and smoothing we can push\nscore updates to Kafka. This will help\nabsorb the bursty traffic if lots of \nupdates keep on coming in.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For durability and smoothing we can push\nscore updates to Kafka. This will help\nabsorb the bursty traffic if lots of \nupdates keep on coming in.",
      "autoResize": true,
      "lineHeight": 1.25
    },
