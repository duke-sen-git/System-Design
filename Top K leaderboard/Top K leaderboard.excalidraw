    {
      "id": "LFFLrHhJyLlp60zciJGlw",
      "type": "text",
      "x": 297,
      "y": 880.23046875,
      "width": 910.4480590820312,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b33",
      "roundness": null,
      "seed": 1111607773,
      "version": 1041,
      "versionNonce": 257766323,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Given the nature of the system and the latency we are willing to target, no single solution would be able to help us \nmeet our requirements, we need a polyglot solution.\n\nUser Meta data (PostgreSQL / Cockroach DB) : \nHandles relational data like user profiles and settings with high consistency.\n\nVideo metadata (MongoDB / Dynamo DB) : \nHold the video meta data information like video titles, CDN urls, creator ids and tags.\n\nInteractions and Counters (Redis + Cassandra) : \nRedis is extremely good and handling writes, as it is completely in memory.\nEvery fixed delay, the content of Redis is published to Cassandra for permanent storage.\n\nMedia Storage (Amazon S3) : \nThe heart of storing uploaded raw (mp4 maybe) files, chunks in our application is a blob store like Amazon S3.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Given the nature of the system and the latency we are willing to target, no single solution would be able to help us \nmeet our requirements, we need a polyglot solution.\n\nUser Meta data (PostgreSQL / Cockroach DB) : \nHandles relational data like user profiles and settings with high consistency.\n\nVideo metadata (MongoDB / Dynamo DB) : \nHold the video meta data information like video titles, CDN urls, creator ids and tags.\n\nInteractions and Counters (Redis + Cassandra) : \nRedis is extremely good and handling writes, as it is completely in memory.\nEvery fixed delay, the content of Redis is published to Cassandra for permanent storage.\n\nMedia Storage (Amazon S3) : \nThe heart of storing uploaded raw (mp4 maybe) files, chunks in our application is a blob store like Amazon S3.",
      "autoResize": true,
      "lineHeight": 1.25
    },
