    {
      "id": "M6PXrTkGvOIaSPUWh8v2X",
      "type": "text",
      "x": 611.40625,
      "y": 1412.21875,
      "width": 331.9200134277344,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
