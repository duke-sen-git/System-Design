    {
      "id": "Sr26dFjDX9w0WDldUmjhs",
      "type": "text",
      "x": 1927.9050613123472,
      "y": 2967.119983322984,
      "width": 294.57598876953125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#121212",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3w",
      "roundness": null,
      "seed": 1581453523,
      "version": 501,
      "versionNonce": 136498035,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1777234846491,
      "link": null,
      "locked": false,
      "text": "Once the orchestrator has \ncompleted, and all the tasks \nare successful, we can then \nupload it to our different storages.\n\nThe first is the encoded storage and\nthis is where we will store the videos\nof different bit rates",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once the orchestrator has \ncompleted, and all the tasks \nare successful, we can then \nupload it to our different storages.\n\nThe first is the encoded storage and\nthis is where we will store the videos\nof different bit rates",
      "autoResize": true,
      "lineHeight": 1.25
    },
