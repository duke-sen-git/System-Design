    {
      "id": "q2v5Am3Eq6gntOYfpLbuP",
      "type": "text",
      "x": 80.99999701976776,
      "y": 5489,
      "width": 498.7035827636719,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2i",
      "roundness": null,
      "seed": 449701093,
      "version": 1581,
      "versionNonce": 2128963813,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769971297990,
      "link": null,
      "locked": false,
      "text": "Now to identify if a token has been processed, we will use\nCDN polling. Instead of using fragile WebSockets, clients can\npoll a CDN cached endpoint.\nCDN is updated about the queued status every 30 seconds.\n\nThe payload of this endpoint would be a generic JSON.\nIt can have a field of serving upto, which can be like 12,000,\nwhich would signify the token number it is serving upto.\n\nThis will be cached at the edge for 10 seconds, and the client \nwill compare with its local token.\n\nExample : Lets say the token of client is 15,000 versus the \nserving id of 12,000.\nIf the local > serving, we know we should wait without touching\nthe backend.\nWith this we can have different backoff strategies, we could \nimplement jittering, to prevent overwhelming a service with too \nmany requests at once. - 3",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Now to identify if a token has been processed, we will use\nCDN polling. Instead of using fragile WebSockets, clients can\npoll a CDN cached endpoint.\nCDN is updated about the queued status every 30 seconds.\n\nThe payload of this endpoint would be a generic JSON.\nIt can have a field of serving upto, which can be like 12,000,\nwhich would signify the token number it is serving upto.\n\nThis will be cached at the edge for 10 seconds, and the client \nwill compare with its local token.\n\nExample : Lets say the token of client is 15,000 versus the \nserving id of 12,000.\nIf the local > serving, we know we should wait without touching\nthe backend.\nWith this we can have different backoff strategies, we could \nimplement jittering, to prevent overwhelming a service with too \nmany requests at once. - 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
