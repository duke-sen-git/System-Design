    {
      "id": "xdxv6T6_XMzIARlgF1f-W",
      "type": "text",
      "x": 1243,
      "y": 2684,
      "width": 461.03961181640625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 826825131,
      "version": 617,
      "versionNonce": 2107632043,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769948879238,
      "link": null,
      "locked": false,
      "text": "Our seating cache can be made via Redis bitfields.\nWe will use high space efficient bitfield, of one bit\nper seat to store real time availability.\nThis acts as the authoritative data origin for the CDN.\nWhen the edge cache expires, the system fetched the \nlatest binary state from the search service, which in turn \ncan pull it from this seating cache, ensuring clients receive \nfresh data",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Our seating cache can be made via Redis bitfields.\nWe will use high space efficient bitfield, of one bit\nper seat to store real time availability.\nThis acts as the authoritative data origin for the CDN.\nWhen the edge cache expires, the system fetched the \nlatest binary state from the search service, which in turn \ncan pull it from this seating cache, ensuring clients receive \nfresh data",
      "autoResize": true,
      "lineHeight": 1.25
    },
