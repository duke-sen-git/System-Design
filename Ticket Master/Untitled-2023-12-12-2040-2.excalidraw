    {
      "id": "E8Ic_h0W-pLvBtxd4swY1",
      "type": "text",
      "x": 1155,
      "y": 3412,
      "width": 517.1035766601562,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 1862402795,
      "version": 276,
      "versionNonce": 221563845,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769949830916,
      "link": null,
      "locked": false,
      "text": "Orchestrates payments with external payment providers like\nStripe, Paypal, Adyen. It handles idempotency keys, to ensure\nusers aren't charged twice if network timeouts occur and manages\nthe reversal logic if a payment fails.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Orchestrates payments with external payment providers like\nStripe, Paypal, Adyen. It handles idempotency keys, to ensure\nusers aren't charged twice if network timeouts occur and manages\nthe reversal logic if a payment fails.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wBW8FxqJ_RgxLUjaCMsJ5",
      "type": "text",
      "x": 588,
      "y": 3533,
      "width": 899.1514892578125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1795835365,
      "version": 303,
      "versionNonce": 142646059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769949982591,
      "link": null,
      "locked": false,
      "text": "Points to talk about : \n1. Handling concurrency and double booking\n2. Handling massive traffic spikes -- the Taylor\nSwift problem\n3. Managing held tickets. If someone acquires a lock for a seat at an event, and does not complete the checkout, \n how do we handle that?",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Points to talk about : \n1. Handling concurrency and double booking\n2. Handling massive traffic spikes -- the Taylor\nSwift problem\n3. Managing held tickets. If someone acquires a lock for a seat at an event, and does not complete the checkout, \n how do we handle that?",
      "autoResize": true,
      "lineHeight": 1.25
    },
