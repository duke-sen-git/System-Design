    {
      "id": "jWQpHlZdB2h5f9XxNHGOL",
      "type": "text",
      "x": 514.7389700413211,
      "y": 3702.3439766955016,
      "width": 398.1796875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
