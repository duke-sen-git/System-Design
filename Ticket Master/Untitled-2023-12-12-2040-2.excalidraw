    {
      "id": "t-Wcd6w-0tW-uDesOSb7I",
      "type": "text",
      "x": 1110.9588644505006,
      "y": 4201.843976695502,
      "width": 668.8396301269532,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5S",
      "roundness": null,
      "seed": 371679621,
      "version": 968,
      "versionNonce": 1726360683,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769971771392,
      "link": null,
      "locked": false,
      "text": "Booking Service attempts to set a key in our active\nreservation Service in Redis. Try to set the Seat Id + User id and see if it doesn't\nexist.\nIf doesn't exist, set an expiry of 10 mins. If Redis returns okay, the user owns the\nlock and it can proceed to do the SQL transaction discussed above to persist the\nrecord.\n\nIf Redis returns null, someone already holds the lock and  we\nreturn error immediately without touching the DB.\n\nIf Db Tx fails / Constraint error, we delete the Redis key to release the lock for\nothers.\n\nSo we use Redis to protect our DB's performance and use DB performance to \nimplement business integrity.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Booking Service attempts to set a key in our active\nreservation Service in Redis. Try to set the Seat Id + User id and see if it doesn't exist.\nIf doesn't exist, set an expiry of 10 mins. If Redis returns okay, the user owns the lock and it can proceed to do the SQL transaction discussed above to persist the record.\n\nIf Redis returns null, someone already holds the lock and  we\nreturn error immediately without touching the DB.\n\nIf Db Tx fails / Constraint error, we delete the Redis key to release the lock for others.\n\nSo we use Redis to protect our DB's performance and use DB performance to \nimplement business integrity.",
      "autoResize": false,
      "lineHeight": 1.25
    },
