      "isDeleted": false,
      "boundElements": [],
      "updated": 1769943430164,
      "link": null,
      "locked": false,
      "text": "1. Searching and viewing seats\n2. Selecting a seat\n3. Making payments for the seats\n4. Confirmation of booking",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Searching and viewing seats\n2. Selecting a seat\n3. Making payments for the seats\n4. Confirmation of booking",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "8_IT8LNzXCQcNeemhV9ad",
      "type": "text",
      "x": 810.1800918579102,
      "y": 273.5,
      "width": 291.0198059082031,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
