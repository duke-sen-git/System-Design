      "seed": 455876267,
      "version": 613,
      "versionNonce": 849362603,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769949606057,
      "link": null,
      "locked": false,
      "text": "This is the transaction heart of the system.\nIt uses ACID compliance, to enforce\nbooking go from Created -> Booked ->\nPayment Pending -> Booking Completed or \nto Booking Cancelled. It uses database\ntransactions to prevent double booking.\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is the transaction heart of the system. It uses ACID compliance, to enforce\nbooking go from Created -> Booked -> Payment Pending -> Booking Completed or \nto Booking Cancelled. It uses database transactions to prevent double booking.\n\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
