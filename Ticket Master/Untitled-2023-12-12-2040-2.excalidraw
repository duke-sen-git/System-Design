    },
    {
      "id": "v5sZu4_3GG78K0_JkBzjP",
      "type": "text",
      "x": 1382,
      "y": 3054,
      "width": 420.1916198730469,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1C",
      "roundness": null,
      "seed": 1371946277,
      "version": 476,
      "versionNonce": 651934789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769952700555,
      "link": null,
      "locked": false,
      "text": "Redis here acts as a distributed lock manager used\nfor temporary seat locks with TTL.\nIt stores temporary holds on seats using TTLs and\nif a user selects a seat, this service sets a key, like :\nSeat 123 ---> Locked by User 456\nbefore the request even hits the slower primary SQL\ndatabase.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis here acts as a distributed lock manager used\nfor temporary seat locks with TTL.\nIt stores temporary holds on seats using TTLs and\nif a user selects a seat, this service sets a key, like :\nSeat 123 ---> Locked by User 456\nbefore the request even hits the slower primary SQL\ndatabase.",
      "autoResize": true,
      "lineHeight": 1.25
    },
