    {
      "id": "caAtr9hYUHLdjP8Bvr9yx",
      "type": "text",
      "x": 845,
      "y": 2396,
      "width": 455.423583984375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 662832459,
      "version": 271,
      "versionNonce": 157686309,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769948328636,
      "link": null,
      "locked": false,
      "text": "Search Service is backed by Elastic Search to handle le\ncomplex queries. Elastic Search is eventually consistent by\nreceiving updates using SideCar indexer or CDC to avoid \nlocking the primary database.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Search Service is backed by Elastic Search to handle le\ncomplex queries. Elastic Search is eventually consistent by\nreceiving updates using SideCar indexer or CDC to avoid \nlocking the primary database.",
      "autoResize": true,
      "lineHeight": 1.25
    },
