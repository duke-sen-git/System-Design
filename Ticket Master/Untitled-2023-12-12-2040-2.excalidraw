    {
      "id": "QD6u10Q2Mkw-zi5F75YOW",
      "type": "text",
      "x": 422,
      "y": 1831,
      "width": 823.3753662109375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
      "roundness": null,
      "seed": 434908965,
      "version": 176,
      "versionNonce": 1214980549,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769945554827,
      "link": null,
      "locked": false,
      "text": "1. Elastic Search / Apache Solr for full text search on Events\n2. Redis : For caching active seat maps, storing temporary \"locks\" on seats and for holding user sessions",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Elastic Search / Apache Solr for full text search on Events\n2. Redis : For caching active seat maps, storing temporary \"locks\" on seats and for holding user sessions",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jEzt-ozjOwUW4is-HKNRw",
      "type": "text",
      "x": 401.6100540161133,
      "y": 1921.5,
      "width": 110.07991027832031,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
