    {
      "id": "j49Bav4hjTUJwe2DMwcY1",
      "type": "text",
      "x": 629,
      "y": 3059.5,
      "width": 357.407470703125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
