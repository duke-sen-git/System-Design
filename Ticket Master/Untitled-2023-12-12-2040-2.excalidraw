    {
      "id": "FZAPCEbxI211ZE6RCC5Cl",
      "type": "arrow",
      "x": 1170.958856344269,
      "y": 7386.593976695502,
      "width": 222.26539659500145,
      "height": 99.39999999999873,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
