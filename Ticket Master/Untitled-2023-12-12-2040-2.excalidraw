      "boundElements": [],
      "updated": 1769971297990,
      "link": null,
      "locked": false,
      "text": "FIFO Queue-ing, Tokens are buffered in a Kafka\nTopic to maintain strict arrival order and status\nset to \"QUEUED\" in the Redis token status\ntracker. This would help us identify \nthat the token\n is now \nqueued- 2",
      "fontSize": 15.400000000000018,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FIFO Queue-ing, Tokens are buffered in a Kafka Topic to maintain strict arrival order and status set to \"QUEUED\" in the Redis token status tracker. This would help us identify \nthat the token\n is now \nqueued- 2",
      "autoResize": false,
      "lineHeight": 1.25
    },
