      "link": null,
      "locked": false,
      "text": "- Given the system requires ACID compliance on booking system, Postgres is a good choice for keeping booking data\n- For caching and searching we can use NoSql databases and in memory stores",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Given the system requires ACID compliance on booking system, Postgres is a good choice for keeping booking data\n- For caching and searching we can use NoSql databases and in memory stores",
      "autoResize": true,
      "lineHeight": 1.25
    },
