      "text": "Handling Traffic Spikes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Handling Traffic Spikes",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4quYoFXSRGv-k_6Lklcf5",
      "type": "text",
      "x": 493,
      "y": 5092.5,
      "width": 1228.1112060546875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1c",
      "roundness": null,
      "seed": 867243141,
      "version": 944,
      "versionNonce": 924195813,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769971297990,
      "link": null,
      "locked": false,
      "text": "Handling massive traffic spikes, like the Taylor Swift problem, where we have 10M simultaneous users vastly exceed database write capacities and would lead \nto immediate cascading failures. The solution is to apply back pressure and level the load using a leaky bucket pattern.\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Handling massive traffic spikes, like the Taylor Swift problem, where we have 10M simultaneous users vastly exceed database write capacities and would lead \nto immediate cascading failures. The solution is to apply back pressure and level the load using a leaky bucket pattern.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
