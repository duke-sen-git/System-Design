      "versionNonce": 1223765957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769970549987,
      "link": null,
      "locked": false,
      "text": "Handling Concurrency and Double Booking",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Handling Concurrency and Double Booking",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FZzmLWlREh-VWM58bX44q",
      "type": "text",
      "x": 519.9588644505008,
      "y": 3768.8439766955016,
      "width": 1191.7269287109375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b50",
      "roundness": null,
      "seed": 2134386347,
      "version": 1069,
      "versionNonce": 181788496,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770016394303,
      "link": null,
      "locked": false,
      "text": "We use Pessimistic Locking + Database level Serialization.\nDatabase strictly orders transactions. \n\nTo implement this, start a Transaction and lock the rows. We can use : SELECT * ... FROM EVENT SEATS where SEAT_ID = __ FOR UPDATE\nThis will ensure other transactions must wait. \nThen we can validate it, with checking the status as available and update.\nIf yes, we can set the status to RESERVED, assign the user id and set expires at = Time now + 10 min and commit it.\n\nSave the changes and release the lock. If validation fails for some reason, roll back immediately.\n\nBut then this alone won't be enough for around 1M users. We also need a mechanism for distributed locking. Hitting the SQL database for every locking \nattempt during a massive sale, for ex, 10K reqs / sec on one seat would crush the DB's CPU. \n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We use Pessimistic Locking + Database level Serialization.\nDatabase strictly orders transactions. \n\nTo implement this, start a Transaction and lock the rows. We can use : SELECT * ... FROM EVENT SEATS where SEAT_ID = __ FOR UPDATE\nThis will ensure other transactions must wait. \nThen we can validate it, with checking the status as available and update.\nIf yes, we can set the status to RESERVED, assign the user id and set expires at = Time now + 10 min and commit it.\n\nSave the changes and release the lock. If validation fails for some reason, roll back immediately.\n\nBut then this alone won't be enough for around 1M users. We also need a mechanism for distributed locking. Hitting the SQL database for every locking \nattempt during a massive sale, for ex, 10K reqs / sec on one seat would crush the DB's CPU. \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
