      "seed": 1565484179,
      "version": 396,
      "versionNonce": 1167048093,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777152948556,
      "link": null,
      "locked": false,
      "text": "Once the upload is complete,\nS3 emits an event which is \npushed to Kafka for downstream\nconsumers",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once the upload is complete,\nS3 emits an event which is \npushed to Kafka for downstream\nconsumers",
      "autoResize": true,
      "lineHeight": 1.25
    },
