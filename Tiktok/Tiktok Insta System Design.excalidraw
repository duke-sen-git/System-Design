      "index": "b5V",
      "roundness": null,
      "seed": 1208363347,
      "version": 359,
      "versionNonce": 1617666195,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777155982949,
      "link": null,
      "locked": false,
      "text": "A batch processor like Spark can work for\nmassive offline analytics that run overnight,\nreading from Cassandra as well as the Vector\nDB embeddings to calculate complex long term \nuser profile and pre computed candidate pool\nresults which will of course be used to update \nthe ML Cache",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A batch processor like Spark can work for\nmassive offline analytics that run overnight,\nreading from Cassandra as well as the Vector\nDB embeddings to calculate complex long term \nuser profile and pre computed candidate pool\nresults which will of course be used to update \nthe ML Cache",
      "autoResize": true,
      "lineHeight": 1.25
    },
