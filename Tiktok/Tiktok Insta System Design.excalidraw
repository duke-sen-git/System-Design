      "boundElements": null,
      "updated": 1777153174323,
      "link": null,
      "locked": false,
      "text": "1 - 9 : Upload Path\n10 -  : The read path\n14 - : The learning Path\nThe learning path focuses on silently captioning every  user interaction and \nrooting it to both real time processing and offline batch jobs to constantly\ntrain the algorithm to enhance the user experience.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 - 9 : Upload Path\n10 -  : The read path\n14 - : The learning Path\nThe learning path focuses on silently captioning every  user interaction and \nrooting it to both real time processing and offline batch jobs to constantly\ntrain the algorithm to enhance the user experience.",
      "autoResize": true,
      "lineHeight": 1.25
    },
