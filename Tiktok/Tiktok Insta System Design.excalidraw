    {
      "id": "k-iUG24gbcKsEYw-9YlRJ",
      "type": "text",
      "x": 2302.6248507232226,
      "y": 1943.2641478189207,
      "width": 429.219970703125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
