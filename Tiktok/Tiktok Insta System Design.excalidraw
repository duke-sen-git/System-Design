    },
    {
      "id": "dIHxo1HXiovZ9FX9_fvKz",
      "type": "text",
      "x": 306,
      "y": 1296,
      "width": 556.2879028320312,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36",
      "roundness": null,
      "seed": 576940349,
      "version": 513,
      "versionNonce": 1862648051,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777141954651,
      "link": null,
      "locked": false,
      "text": "Upload Video\n- /v1/videos/upload\nReturns a presigned url for direct upload to Amazon S3\n\nFetch Feed\n- /v1/search?q={query}\nReturns a JSON containing the top 10 videos along with their CDN urls\n\nLike Video\n- /v1/videos/{videoId}/interactions\nPayload : {\"interaction\" : \"LIKE\", \"videoId\" : \"12....89\"}\n\nTelemetry \n- /v1/telemetry\nBatched background endpoint for sending watch time and skip metrics",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upload Video\n- /v1/videos/upload\nReturns a presigned url for direct upload to Amazon S3\n\nFetch Feed\n- /v1/search?q={query}\nReturns a JSON containing the top 10 videos along with their CDN urls\n\nLike Video\n- /v1/videos/{videoId}/interactions\nPayload : {\"interaction\" : \"LIKE\", \"videoId\" : \"12....89\"}\n\nTelemetry \n- /v1/telemetry\nBatched background endpoint for sending watch time and skip metrics",
      "autoResize": true,
      "lineHeight": 1.25
    },
