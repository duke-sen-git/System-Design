      "boundElements": null,
      "updated": 1777155166316,
      "link": null,
      "locked": false,
      "text": "The Redis\ncache is a\nhyperfast in\nmemory store, \nholding\nprecomputed\ncandidate\npools, user\nprofile\nvectors and\nreal time video\nmultipleers.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Redis cache is a hyperfast in memory store, \nholding precomputed candidate pools, user profile\nvectors and real time video multipleers.",
      "autoResize": false,
      "lineHeight": 1.25
    },
