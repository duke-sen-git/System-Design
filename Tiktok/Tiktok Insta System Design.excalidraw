      "index": "b5P",
      "roundness": null,
      "seed": 1158902163,
      "version": 336,
      "versionNonce": 281251005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777155816666,
      "link": null,
      "locked": false,
      "text": "Cassandra is a massive NoSQL store\nthat serves as the permanent historical\nrecord. A background cron job can sweep\nthe Redis buffer and flush the aggregated\nresults into Cassandra, turning the 100K\ncache increments into a single DB write\nwhich is a massive performance improvement.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cassandra is a massive NoSQL store\nthat serves as the permanent historical\nrecord. A background cron job can sweep\nthe Redis buffer and flush the aggregated\nresults into Cassandra, turning the 100K\ncache increments into a single DB write\nwhich is a massive performance improvement.",
      "autoResize": true,
      "lineHeight": 1.25
    },
