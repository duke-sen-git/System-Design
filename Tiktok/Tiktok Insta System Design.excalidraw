    },
    {
      "id": "j-D7H5vBe0qNsmJsxit2_",
      "type": "text",
      "x": 2287.5495925623472,
      "y": 3082.530139572984,
      "width": 258.7359619140625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b47",
      "roundness": null,
      "seed": 1612195901,
      "version": 245,
      "versionNonce": 329068605,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777152081156,
      "link": null,
      "locked": false,
      "text": "This is our origin for our CDN\nand, we want to cache this video\ncloser to the user, so user can \nstart streaming the video really \nquickly. ",
      "fontSize": 16,
      "fontFamily": 5,
