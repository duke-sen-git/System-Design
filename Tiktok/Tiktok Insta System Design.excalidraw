    {
      "id": "CPTFvA_PQNiAzeDJRCHlg",
      "type": "text",
      "x": 1575.3823237953552,
      "y": 2092.0542527311422,
      "width": 470.7999572753906,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b55",
      "roundness": null,
      "seed": 208121715,
      "version": 541,
      "versionNonce": 106435613,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777156008200,
      "link": null,
      "locked": false,
      "text": "Apache flink will read the live Kafka stream, and it\nwill instantly update the machine learning cache with\nsession context.\n\nWe can build in that the user is swiping fast, and update\nvideo virality scores so we can optimize what video the user\nis shown and the result is put into ML cache.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apache flink will read the live Kafka stream, and it\nwill instantly update the machine learning cache with\nsession context.\n\nWe can build in that the user is swiping fast, and update\nvideo virality scores so we can optimize what video the user\nis shown and the result is put into ML cache.",
      "autoResize": true,
      "lineHeight": 1.25
    },
